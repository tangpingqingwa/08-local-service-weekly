# Copy to .env.local. Never commit secrets.
# Explicitly choose exactly one mode; no missing key may select a provider.
PAYMENT_MODE=fixture

# Local/offline fixture mode (does not call Waffo). The historical Polar
# fixture switch below is quarantined and ignored by runtime.

# Waffo Pancake test or production mode requires every value below.
# PAYMENT_MODE=waffo-test | PAYMENT_MODE=waffo-prod
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_PUBLIC_BASE_URL=https://example.invalid
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
DATABASE_PATH=./data/app.sqlite

# Historical Polar research/compatibility keys are quarantined and ignored by runtime.
# POLAR_LIVE, POLAR_ACCESS_TOKEN, POLAR_PRODUCT_ID, POLAR_WEBHOOK_SECRET,
# POLAR_API_BASE, and WAFFO_LIVE are intentionally not provider selectors.
# POLAR_LIVE=
WAFFO_LIVE=
